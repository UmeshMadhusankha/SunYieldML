{
  "name": "sunyield-backend", "version": "1.0.0", "private": true,
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node src/server.js", "dev": "node --watch src/server.js",
    "lint": "eslint src tests scripts", "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand --coverage", "test:integration": "jest --runInBand tests/postgres.test.js",
    "migrate": "node scripts/migrate.js", "benchmark": "node scripts/benchmark.js", "test:native": "node --test tests/native.test.cjs"
  },
  "dependencies": { "express": "5.3.0", "pg": "^8.16.3", "zod": "^4.1.12", "cors": "^2.8.5", "helmet": "^8.1.0", "cookie-parser": "^1.4.7", "express-rate-limit": "^8.2.1", "dotenv": "^17.2.3" },
  "devDependencies": { "jest": "30.5.2", "supertest": "^7.1.4", "eslint": "^9.39.1", "globals": "^16.5.0" },
  "jest": { "testEnvironment": "node", "testMatch": ["**/*.test.js"], "collectCoverageFrom": ["src/**/*.js", "!src/server.js"], "coverageThreshold": { "./src/domain/finance.js": { "branches": 70, "lines": 85 }, "./src/integrations/breaker.js": { "branches": 80, "lines": 90 } } }
}
